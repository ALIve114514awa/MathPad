{
  "name": "math-pad",
  "productName": "MathPad",
  "version": "0.4.9",
  "description": "A floating graphing panel for Windows presentations",
  "main": "src/main.cjs",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:app": "electron scripts/smoke-offline.cjs",
    "test:polish": "electron scripts/smoke-polish.cjs",
    "test:edit": "electron scripts/smoke-curve-edit.cjs",
    "test:python": "electron scripts/smoke-python.cjs",
    "test:tray": "electron scripts/smoke-tray.cjs",
    "test:launcher": "node scripts/smoke-launcher.cjs",
    "test:portable": "node scripts/smoke-portable.cjs",
    "test:floating": "electron scripts/smoke-floating.cjs",
    "verify:geogebra": "node scripts/verify-geogebra.cjs",
    "verify:licenses": "node scripts/verify-licenses.cjs",
    "verify:portable": "node scripts/verify-portable.cjs",
    "make": "electron-forge make --platform win32 --arch x64",
    "package": "electron-forge package --platform win32 --arch x64",
    "portable:local": "npm run package && node scripts/sync-portable.cjs",
    "portable": "npm run make && node scripts/sync-portable.cjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "electron": "45.2.3"
  },
  "dependencies": {
    "katex": "0.19.1",
    "nerdamer": "2.0.1"
  }
}
